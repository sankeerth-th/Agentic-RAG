# Fake local-only development values; use secrets supplied externally elsewhere.
POSTGRES_PASSWORD=local-rag-password
DATABASE_URL=postgresql+psycopg://rag:local-rag-password@127.0.0.1:55432/rag
REDIS_URL=redis://127.0.0.1:56379/0
QDRANT_URL=http://127.0.0.1:56333
S3_ENDPOINT_URL=http://127.0.0.1:59000
S3_ACCESS_KEY_ID=local-rag-user
S3_SECRET_ACCESS_KEY=local-rag-password
S3_BUCKET=rag-sources
S3_REGION=us-east-1
DEPENDENCY_TIMEOUT_SECONDS=2
